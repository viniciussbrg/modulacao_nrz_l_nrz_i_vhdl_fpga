   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="91"></NameColumnWidth>
      <ValueColumnWidth column_width="183"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="6" />
   <wvobject fp_name="/tb_nrz_i/clk" type="logic">
      <obj_property name="ElementShortName">clk</obj_property>
      <obj_property name="ObjectShortName">clk</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_nrz_i/rst" type="logic">
      <obj_property name="ElementShortName">rst</obj_property>
      <obj_property name="ObjectShortName">rst</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_nrz_i/uut/bit_index" type="other">
